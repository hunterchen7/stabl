# Copy to deploy/stabl.env on the box (read by systemd) and fill in:
# Generate the plaintext key on your Mac:
#   openssl rand -hex 32
# Hash it and paste the hash here:
#   echo -n '<plaintext>' | shasum -a 256 | awk '{print $1}'
STABL_API_KEY_HASH=
STABL_DATA_DIR=/home/olares/stabl-data
STABL_PORT=8000

# Cloudflare R2 — needed for the /v1/upload/r2/* endpoints (big files).
# Account ID is the short id in the dash URL: dash.cloudflare.com/<account_id>/...
# Create a bucket (e.g. "stabl-uploads") and an R2 API token with read+write to it.
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
